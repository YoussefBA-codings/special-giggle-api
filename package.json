{
  "name": "scraping-logement-api",
  "version": "1.0.0",
  "description": "API immobilière nationale des communes françaises",
  "main": "dist/main.js",
  "scripts": {
    "build": "./node_modules/.bin/nest build",
    "start": "node dist/main.js",
    "start:dev": "./node_modules/.bin/ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:prod": "node dist/main.js",
    "data:generate": "./node_modules/.bin/ts-node --transpile-only -r tsconfig-paths/register src/scripts/generate-data.ts",
    "data:update:city": "./node_modules/.bin/ts-node --transpile-only -r tsconfig-paths/register src/scripts/update-city.ts",
    "data:update:department": "./node_modules/.bin/ts-node --transpile-only -r tsconfig-paths/register src/scripts/update-department.ts",
    "data:update:region": "./node_modules/.bin/ts-node --transpile-only -r tsconfig-paths/register src/scripts/update-region.ts",
    "data:clean": "./node_modules/.bin/ts-node --transpile-only -r tsconfig-paths/register src/scripts/clean-data.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^6.2.1",
    "puppeteer": "^24.43.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "25.9.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0"
  }
}
